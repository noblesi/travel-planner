# EC2의 /opt/withtrip/.env로 복사한 뒤 실제 값으로 변경합니다.
# 이 파일의 예시값이나 실제 .env 파일을 Git에 커밋하지 않습니다.
ORACLE_URL=jdbc:oracle:thin:@//oracle-host:1521/service-name
ORACLE_USERNAME=withtrip_dev
ORACLE_PASSWORD=change-me

SERVER_FORWARD_HEADERS_STRATEGY=framework
AUTH_ENFORCE_SECURITY=true
# HTTP 시연 전용입니다. HTTPS 전환 시 반드시 true로 변경합니다.
SESSION_COOKIE_SECURE=false

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM=change-me
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
MAIL_ASYNC_CORE_POOL_SIZE=2
MAIL_ASYNC_MAX_POOL_SIZE=4
MAIL_ASYNC_QUEUE_CAPACITY=100
MAIL_ASYNC_AWAIT_TERMINATION=10s
# EC2 Public IPv4가 203.0.113.10이라면 http://203.0.113.10 형식으로 입력합니다.
FRONTEND_BASE_URL=change-me

TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=change-me
TOUR_API_MOBILE_APP=WithTrip
TOUR_API_CONNECT_TIMEOUT=3s
TOUR_API_READ_TIMEOUT=5s

KAKAO_REST_BASE_URL=https://dapi.kakao.com
KAKAO_REST_API_KEY=change-me
KAKAO_REST_CONNECT_TIMEOUT=3s
KAKAO_REST_READ_TIMEOUT=5s
