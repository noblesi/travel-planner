<header class="site-header">
    <div class="content-container site-header__inner">
        <a class="brand" href="${pageContext.request.contextPath}/" aria-label="${applicationName} 홈">
            <span class="brand__mark" aria-hidden="true"></span>
            <span class="brand__name">${applicationName}</span>
        </a>

        <nav class="primary-nav" aria-label="주요 메뉴">
            <a href="${pageContext.request.contextPath}/#service-introduction">서비스 소개</a>
            <a class="button button--primary" href="${pageContext.request.contextPath}/#service-introduction">여행 계획하기</a>
        </nav>
    </div>
</header>
