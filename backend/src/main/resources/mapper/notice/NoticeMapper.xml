<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.noblesi.travelplanner.notice.dao.NoticeDAO">

	<resultMap id="noticeListResultMap" type="com.noblesi.travelplanner.notice.dto.NoticeListResponseDTO">
		<constructor>
			<arg column="NOTICE_ID" javaType="java.lang.Long" />
			<arg column="CATEGORY_CODE" javaType="java.lang.String" />
			<arg column="TITLE" javaType="java.lang.String" />
			<arg column="CREATED_AT" javaType="java.time.LocalDate" />
		</constructor>
	</resultMap>

	<resultMap id="noticeDetailResultMap" type="com.noblesi.travelplanner.notice.dto.NoticeDetailResponseDTO">
		<constructor>
			<arg column="NOTICE_ID" javaType="java.lang.Long" />
			<arg column="CATEGORY_CODE" javaType="java.lang.String" />
			<arg column="TITLE" javaType="java.lang.String" />
			<arg column="CONTENT" javaType="java.lang.String" />
			<arg column="VIEW_COUNT" javaType="_int" />
			<arg column="CREATED_AT" javaType="java.time.LocalDate" />
		</constructor>
	</resultMap>

	<select id="selectNoticeList" resultMap="noticeListResultMap">
		SELECT NOTICE_ID,
		       CATEGORY_CODE,
		       TITLE,
		       CREATED_AT
		  FROM (
		        SELECT a.*, ROWNUM AS RN
		          FROM (
		                SELECT NOTICE_ID,
		                       CATEGORY_CODE,
		                       TITLE,
		                       TRUNC(CREATED_AT) AS CREATED_AT
		                  FROM NOTICE
		                 WHERE HIDDEN_YN = 'N'
		                <if test="category != null and category != ''">
		                   AND CATEGORY_CODE = #{category}
		                </if>
		                 ORDER BY CREATED_AT DESC, NOTICE_ID DESC
		               ) a
		         WHERE ROWNUM &lt;= (#{page} * #{size})
		       )
		 WHERE RN &gt; (#{page} - 1) * #{size}
	</select>

	<select id="countNoticeList" resultType="long">
		SELECT COUNT(*)
		  FROM NOTICE
		 WHERE HIDDEN_YN = 'N'
		<if test="category != null and category != ''">
		   AND CATEGORY_CODE = #{category}
		</if>
	</select>

	<select id="selectNoticeById" resultMap="noticeDetailResultMap">
		SELECT NOTICE_ID,
		       CATEGORY_CODE,
		       TITLE,
		       CONTENT,
		       VIEW_COUNT,
		       TRUNC(CREATED_AT) AS CREATED_AT
		  FROM NOTICE
		 WHERE NOTICE_ID = #{noticeId}
		   AND HIDDEN_YN = 'N'
	</select>

	<update id="updateNoticeViewCount">
		UPDATE NOTICE
		   SET VIEW_COUNT = VIEW_COUNT + 1
		 WHERE NOTICE_ID = #{noticeId}
		   AND HIDDEN_YN = 'N'
	</update>

</mapper>
