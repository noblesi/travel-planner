# 실행 환경변수 이름 참고용입니다. 실제 비밀번호와 인증키는 커밋하지 않습니다.
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USERNAME=travel_planner
ORACLE_PASSWORD=change-me
SERVER_PORT=8080
SESSION_COOKIE_SECURE=true

# local Profile 실행 설정. 이메일 로그인은 MEMBER 테이블을 사용합니다.
# AUTH_ENFORCE_SECURITY=true이면 플랜 변경 API도 로그인 session을 요구합니다.
# LOCAL_MEMBER_ID는 보안 비활성 local 개발 흐름의 현재 회원 fallback에만 사용합니다.
AUTH_ENFORCE_SECURITY=false
LOCAL_MEMBER_ID=1

# TourAPI 국문 관광정보 서비스
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=change-me
TOUR_API_MOBILE_APP=WithTrip
TOUR_API_CONNECT_TIMEOUT=3s
TOUR_API_READ_TIMEOUT=5s

# Kakao REST API (서버 전용)
KAKAO_REST_BASE_URL=https://dapi.kakao.com
KAKAO_REST_API_KEY=change-me
KAKAO_REST_CONNECT_TIMEOUT=3s
KAKAO_REST_READ_TIMEOUT=5s
